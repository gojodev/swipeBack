{
  "manifest_version": 3,
  "name": "SwipeBack",
  "version": "1.1",
  "description": "Navigate tabs with finger gestures",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "SwipeBack",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "js": ["content.js"],
      "css": ["style.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": ["*://*/*"],
  "permissions": ["activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "forwardGesture": {
      "suggested_key": {
        "default": "Alt+Right"
      },
      "description": "Perform a forward gesture"
    },
    "backwardGesture": {
      "suggested_key": {
        "default": "Alt+Left"
      },
      "description": "Perform a backward gesture"
    }
  }
}
